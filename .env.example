# ─────────────────────────────────────────────
# Autonomous Research Agent — Environment Variables
# Copy this file to .env and fill in your keys.
# ─────────────────────────────────────────────

# Groq API key (used for Llama 3.3 70B inference)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tavily API key (used for web search)
# Get yours at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Anthropic API key (only needed if switching the LLM to Claude)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
