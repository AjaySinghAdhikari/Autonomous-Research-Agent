# Groq API Key (Llama 3.3)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key for search
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Anthropic API Key if switching brains
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google API Key for text embeddings
GOOGLE_API_KEY=your_google_api_key_here

# Google Application Credentials path for Firebase Admin SDK
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/firebase-adminsdk.json

# LangSmith Tracing
LANGCHAIN_API_KEY=your_langchain_api_key_here

# Google Cloud Logging
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
